{
  "manifest_version": 3,
  "name": "Tab Filter",
  "version": "0.1.3",
  "description": "Search open tabs and switch with the keyboard.",
  "author": "Sander van Dragt <sander@vandragt.com>",
  "homepage_url": "https://github.com/svandragt/tab-filter",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "tabs"
  ],
  "action": {
    "default_title": "Tab Filter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Insert"
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-filter@vandragt.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
