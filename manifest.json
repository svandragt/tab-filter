{
  "manifest_version": 3,
  "name": "Tab Filter",
  "version": "0.1.1",
  "description": "Search open tabs and switch with the keyboard.",
  "permissions": ["tabs"],
  "action": { "default_title": "Tab Filter", "default_popup": "popup.html" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Insert" } }
  },
  "browser_specific_settings": { "gecko": {
    "id": "tab-switcher@local",
    "data_collection_permissions": { "required": ["none"] }
  } }
}
